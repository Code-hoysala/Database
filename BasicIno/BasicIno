void setup() {
    Serial.begin(9600);
    while (!Serial);

    initializeDatabases();

    Serial.println(F("=========================================="));
    Serial.println(F("       EMBEDDED KNOWLEDGE SYSTEM          "));
    Serial.println(F("=========================================="));
    Serial.println(F("[1] Play Akinator (Fictional Characters)"));
    Serial.println(F("[2] Query Encyclopedia Reference"));
    Serial.println(F("------------------------------------------"));
}

void loop() {
    if (Serial.available() > 0) {
        char mode = Serial.read();
        
        while (Serial.available() > 0) Serial.read();

        if (mode == '1') {
            runAkinatorGame();
        } else if (mode == '2') {
            char buffer[128];
            if (pkgScience.get("einstein", buffer, sizeof(buffer))) {
                Serial.print(F("\n[Science Query - Einstein]: "));
                Serial.println(buffer);
            } else {
                Serial.println(F("\nRecord not found in database."));
            }
        }
        
        Serial.println(F("\nSelect mode: [1] Akinator [2] Encyclopedia"));
    }
}

