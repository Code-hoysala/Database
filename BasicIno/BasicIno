void runAkinatorGame() {
    char buffer[128];
    char answer[4];

    Serial.println(F("\n--- STARTING AKINATOR (FICTIONAL CHARACTERS) ---"));
    
    if (akinatorPkg.get("q1", buffer, sizeof(buffer))) {
        Serial.println(buffer);
        while (Serial.available() == 0);
        int len = Serial.readBytesUntil('\n', answer, sizeof(answer) - 1);
        answer[len] = '\0';

        if (answer[0] == 'y' || answer[0] == 'Y') {
            if (akinatorPkg.get("iron_man", buffer, sizeof(buffer))) {
                Serial.print(F("Match Found: "));
                Serial.println(buffer);
            }
        } else {
            if (akinatorPkg.get("harry_potter", buffer, sizeof(buffer))) {
                Serial.print(F("Match Found: "));
                Serial.println(buffer);
            }
        }
    }
}
